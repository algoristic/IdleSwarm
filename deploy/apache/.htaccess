# Apache-Konfiguration für den Server-Rollout von `main`.
# Die CI legt diese Datei neben den Build unter /IdleSwarm/.

# SPA-Fallback: vorhandene Dateien und Ordner direkt, alle anderen Pfade an index.html, damit das
# Angular-Routing greift.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /IdleSwarm/
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Der Einstieg wird immer neu geprüft; Bundles tragen einen Hash im Namen und dürfen lange im
# Cache bleiben.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
